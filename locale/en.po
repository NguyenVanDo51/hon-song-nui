msgid "Công Thành Chiến"
msgstr "Công Thành Chiến"

#: content/theme.gd:52
msgid "Cờ chiến thuật theo lượt"
msgstr "Turn-based tactics"

#: content/theme.gd:53
msgid "Nửa đế quốc đã theo Ma Vương. Giành lại từng lâu đài."
msgstr "Half the empire has sworn to the Demon Lord. Win back every castle."

#: content/theme.gd:55
msgid "Lượt quân Ma Vương"
msgstr "Demon Lord's turn"

#: content/theme.gd:56
msgid "Hiệp Sĩ Chỉ Huy đấu với Vorn"
msgstr "Knight Commander vs Vorn"

#: content/theme.gd:57
msgid "Hai người chung máy, hoặc đấu với máy"
msgstr "Two players on one device, or play the computer"

