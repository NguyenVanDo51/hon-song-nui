msgstr "▶ Got it"

#: content/theme.gd:92
msgid "Xuất quân ›"
msgstr "March ›"

#: content/theme.gd:93
msgid "🔒 Chưa chiếm lại: thắng màn trước để mở"
msgstr "🔒 Not retaken yet: win the previous level to unlock"

#: content/theme.gd:94
msgid "Mọi quân đã đi (xám): bấm Hết lượt"
msgstr "Every unit has moved (grey): press End Turn"

#: content/theme.gd:95
msgid "quân địch"
msgstr "enemy units"

#: content/theme.gd:96
msgid "{capV} đứng vào làng rồi bấm Chiếm: +{income} vàng/lượt, hồi máu quân ta."
msgstr "{capV}: stand on the village, then press Capture: +{income} gold/turn, heals our units."

#: content/theme.gd:97
msgid "Làng bị {raze} đốt cháy. {capV} đứng vào rồi bấm Dựng lại làng; lượt sau mới chiếm được."
msgstr "Village burned by {raze}. {capV}: stand on it and press Rebuild village; it can be captured the turn after."

#: content/theme.gd:98
msgid "Chỉ {capC_l} chiếm được lâu đài. Lâu đài: +{income} vàng/lượt, mua lính, hồi máu. Có quân ta đứng trên lâu đài vẫn mua được: lính mới phải bước ra ô khác."
msgstr "Only {capC_l} can capture castles. Castle: +{income} gold/turn, recruit units, heal. You can still recruit with one of our units on the castle: the new unit has to step off."

#: content/theme.gd:99
msgid "Giếng Thần: không ai chiếm được. Quân phe nào đứng đây cũng hồi {heal} máu mỗi lượt, thủ +15."
msgstr "Holy Well: nobody can capture it. A unit of either side standing here heals {heal} HP each turn, DEF +15."

#: content/theme.gd:100
msgid "Mọi quân lội được nhưng tốn 3 bước và không được thủ. {water} chỉ tốn 1 bước, đứng dưới sông +15 công, +25 thủ."
msgstr "Every unit can wade across, but it costs 3 steps and gives no defense. {water} needs only 1 step, and in the river gets +15 ATK, +25 DEF."

#: content/theme.gd:101
msgid "Mẹo: giữ tướng sau hàng vệ binh; đứng trên đồi, làng, lâu đài được thêm thủ."
msgstr "Tip: keep the commander behind your guards; hills, villages and castles add defense."

#: content/theme.gd:102
msgid "Mẹo: luôn để một quân đứng chặn trên lâu đài khi địch có tướng ở gần."
msgstr "Tip: always keep a unit on your castle when the enemy commander is close."

#: content/theme.gd:103
msgid "Mẹo: chiếm làng sớm để có vàng mua quân; đừng đem lính lẻ ra đánh."
msgstr "Tip: capture villages early for gold to recruit; don't send units out alone."

#: content/theme.gd:104
msgid "Mẹo: đi đường mòn cho nhanh, để vệ binh chặn đường đuổi phía sau."
msgstr "Tip: take the trails to move fast, and leave guards to block pursuers behind you."

#: content/theme.gd:106
msgid "Thắng trận"
msgstr "Win the battle"

#: content/theme.gd:107
msgid "Tướng ta không ngã lần nào"
msgstr "Our commander never falls"

