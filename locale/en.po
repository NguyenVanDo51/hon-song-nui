msgstr "{side} wins"

#: content/theme.gd:60
msgid "{loser} mất hết lâu đài, tướng cũng đã ngã."
msgstr "{loser} lost every castle, and its commander has fallen."

#: content/theme.gd:61
msgid "{loser} không còn quân, không còn lâu đài."
msgstr "{loser} has no units and no castles left."

#: content/theme.gd:62
msgid "{loser} đã đầu hàng."
msgstr "{loser} surrendered."

#: content/theme.gd:63
msgid "Lượt của {side}"
msgstr "{side}'s turn"

#: content/theme.gd:64
msgid "Lượt {turn} · chạm để bắt đầu"
msgstr "Turn {turn} · tap to start"

#: content/theme.gd:65
msgid "gọi hồn"
msgstr "raise the dead"

#: content/theme.gd:66
msgid "☠ Gọi hồn"
msgstr "☠ Raise Dead"

#: content/theme.gd:67
msgid "Lính ngã: pháp sư gọi hồn đứng cạnh dựng dậy được thành bộ xương. Mất sau lượt kế của mỗi bên, hoặc khi có quân bước lên."
msgstr "Fallen soldier: a Necromancer standing next to it can raise it as a skeleton. Gone after each side's next turn, or when a unit steps on it."

#: content/theme.gd:68
msgid "Lính ngã"
msgstr "Fallen soldier"

#: content/theme.gd:69
msgid "Lượt {turn} · Quân ta"
msgstr "Turn {turn} · Our army"

